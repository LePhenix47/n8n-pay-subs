      "name": "Extract PDF text"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst frenchMonthNames = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];\nconst yearGroups = {};\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const text = item.json.text ?? '';\n  const internalDate = item.json.internalDate;\n\n  let month = null;\n  let year = null;\n\n  // Primary: parse \"Salaire versé le : DD/MM/YY\" from PDF text\n  const salMatch = text.match(/Salaire vers[eé] le\\s*:\\s*(\\d{2})\\/(\\d{2})\\/(\\d{2,4})/i);\n  if (salMatch) {\n    const monthNum = parseInt(salMatch[2]);\n    month = frenchMonthNames[monthNum - 1] ?? null;\n    const yr = salMatch[3];\n    year = yr.length === 2 ? '20' + yr : yr;\n  }\n\n  // Fallback: email internal date\n  if ((!month || !year) && internalDate) {\n    const d = new Date(parseInt(internalDate));\n    if (!year) year = d.getFullYear().toString();\n    if (!month) month = frenchMonthNames[d.getMonth()];\n  }\n\n  year = year || 'unknown';\n  const fileName = month ? `${month}_${year}.pdf` : `paystub_${i}.pdf`;\n\n  if (!yearGroups[year]) yearGroups[year] = {};\n\n  const bin = item.binary?.attachment_0;\n  if (bin) {\n    const idx = Object.keys(yearGroups[year]).length;\n    yearGroups[year][`pdf_${idx}`] = { ...bin, fileName };\n  }\n}\n\nreturn Object.entries(yearGroups).map(([year, binaryData]) => ({\n  json: { year },\n  binary: binaryData\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
