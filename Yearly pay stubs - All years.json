    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  try {\n    const buf = await this.helpers.getBinaryDataBuffer(items[i], 'attachment_0');\n    const header = buf.slice(0, 20).toString('latin1');\n    const tail = buf.slice(-50).toString('latin1');\n    results.push({ index: i, size: buf.length, header, tail });\n  } catch (e) {\n    results.push({ index: i, size: 0, error: e.message });\n  }\n}\n\nreturn [{ json: { results } }];\n"
      },
